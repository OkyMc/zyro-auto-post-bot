# ==========================================
# Discord SelfBot Message Scheduler - Config
# ==========================================

# Port HTTP Express Server (Webhook PaKasir & Healthcheck)
PORT=3000

# MySQL Database Connection String (Prisma ORM)
DATABASE_URL="mysql://root:password@127.0.0.1:3306/discord_saas"

# Discord Bot Manager Credentials (Bot Utama)
BOT_TOKEN="your_bot_token_here"
CLIENT_ID="your_bot_client_id_here"
GUILD_ID="your_primary_discord_server_id_here"

# Security (Wajib String tepat 32 Karakter untuk enkripsi AES-256)
ENCRYPTION_KEY="12345678901234567890123456789012"

# Payment Gateway (PaKasir QRIS)
PAKASIR_API_KEY="your_pakasir_api_key_here"
PAKASIR_PROJECT_SLUG="your_pakasir_project_slug_here"
PAKASIR_API_URL="https://app.pakasir.com/api"
WEBHOOK_URL="https://your-domain.com/api/webhook/payment"

# Administration
ADMIN_ID="your_discord_user_id_here"
ADMIN_ROLE_ID="your_admin_role_id_here"

# Product Pricing (Dalam Rupiah / IDR)
PRICE_7_DAYS="10000"
PRICE_30_DAYS="35000"

# ==========================================
# License API Key System (Opsi Jual Script)
# ==========================================
# License Key yang diberikan ke buyer
LICENSE_KEY="ZYRO-XXXX-XXXX-XXXX"

# URL Central License Server milik seller (misal https://license.domainlu.com)
LICENSE_SERVER_URL="http://localhost:4000"

# Interval Heartbeat check lisensi ke server (dalam menit, default 30)
LICENSE_CHECK_INTERVAL_MINUTES="30"

# Set false untuk bypass lisensi khusus developer saat local dev (default: true)
ENABLE_LICENSE_CHECK="true"

